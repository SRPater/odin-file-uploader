<%- include('partials/header') %>

<% if (locals.user) { %>
  <h2>Welcome back, <%= user.username %>!</h2>
  <p>Browse your uploaded files below.</p>

  <div class="file-container">
    <% if (
      (locals.folders && folders.length > 0) ||
      (locals.files && files.length > 0)
    ) { %>
      <%- include('partials/files') %>
    <% } else { %>
      <p>You haven't uploaded any files or created any folders yet.</p>
      <div class="button-group">
        <a href="/files/upload" class="button-cyan">Upload File</a>
        <a href="/folders/create" class="button-cyan">Create Folder</a>
      </div>
    <% } %>
  </div>
<% } else { %>
  <h2>Welcome to the File Uploader!</h2>
  <p>Log in now to start uploading files.</p>

  <form action="/log-in" method="POST" class="auth-form">
    <% if (errors && errors.length > 0) { %>
      <ul class="form-errors">
        <% errors.forEach(error => { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    <% } %>
    <div class="form-group">
      <label for="username">Username</label>
      <input type="text" name="username" id="username" required>
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" name="password" id="password" required>
    </div>
    <button type="submit" class="button-cyan">Log In</button>
    <p class="form-footer">
      Don't have an account yet? Sign up <a href="/sign-up">here</a>.
    </p>
  </form>
<% } %>

<%- include('partials/footer') %>