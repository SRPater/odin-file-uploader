<table>
  <thead>
    <tr>
      <td>Name</td>
      <td>Date Uploaded</td>
      <td>Filesize</td>
      <td>
        <a href="/folders/create">
          <span class="icon folder-plus"></span>
        </a>
      </td>
    </tr>
  </thead>
  <tbody>
    <% folders.forEach(folder => { %>
      <tr>
        <td class="filename">
          <span class="icon folder"></span>
          <a href="/folders/<%= folder.id %>"><%= folder.name %></a>
        </td>
        <td></td>
        <td></td>
        <td class="file-actions">
          <form action="/folders/delete/<%= folder.id %>" method="POST">
            <button type="submit" class="icon-button">
              <span class="icon delete"></span>
            </button>
          </form>
        </td>
      </tr>
    <% }) %>

    <% files.forEach(file => { %>
      <tr>
        <td class="filename">
          <span class="icon <%= file.iconClass %>"></span>
          <%= file.name %>
        </td>
        <td><%= file.createdAt.toLocaleDateString('en-GB', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric'
        }) %></td>
        <td>
          <% if (file.size >= 1024 * 1024) { %>
            <%= (file.size / (1024 * 1024)).toFixed(2) + ' MB' %>
          <% } else if (file.size >= 1024) { %>
            <%= (file.size / 1024).toFixed(2) + ' kB' %>
          <% } else { %>
            <%= file.size.toFixed(2) + ' B' %>
          <% } %>
        </td>
        <td class="file-actions">
          <a href="/files/download/<%= file.id %>">
            <span class="icon download"></span>
          </a>
          <form action="/files/delete/<%= file.id %>" method="POST">
            <button type="submit" class="icon-button">
              <span class="icon delete"></span>
            </button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>